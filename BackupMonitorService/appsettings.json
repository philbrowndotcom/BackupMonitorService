{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "BackupMonitor": {
    "ContainerUrl": "",
    "SasToken": "",
    "DebounceSeconds": 30,
    "RetryDelaySeconds": 300,
    "FullSyncIntervalMinutes": 0,
    "BackupOnStartup": true,
    "MaxParallelUploads": 8,
    "Folders": [
      {
        "Path": "D:\\Media\\images",
        "Destination": "Images"
      },
      {
        "Path": "D:\\Backup",
        "Destination": "Backup"
      }
    ]
  }
}
